# DashScope API Configuration
DASHSCOPE_API_KEY=YOUR-API-KEY

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR-PASSWORD
DB_NAME_QWEN=qwen_embeddings

# Auto bootstrap qwen database from OSS when DB is missing.
# Supported artifacts at QWEN_DB_OSS_URL:
# 1) pg_dump file (.dump / .dump.gz / plain.sql / .sql.gz)
# 2) embeddings archive (.tar.gz) containing qwen_text_embeddings.h5 + qwen_image_embeddings.h5
QWEN_DB_AUTO_BOOTSTRAP=true
QWEN_DB_OSS_URL=https://huggingface.co/datasets/zipingli/objaverse_retrieval_embeddings/resolve/main/qwen_embeddings_20260212_170200.dump.gz
QWEN_DB_DUMP_FORMAT=auto
QWEN_DB_DUMP_LOCAL_PATH=/tmp/qwen_embeddings.dump
QWEN_DB_REUSE_LOCAL_DUMP=true
QWEN_DB_DOWNLOAD_TIMEOUT_SECONDS=1800

# Processing Configuration
MAX_ASSETS=200

# 3D Model Base URL template
BASE_URL_TEMPLATE=https://huggingface.co/datasets/allenai/objaverse/resolve/main/glbs/{objaverse_dir}/{objaverse_id}.glb?download=true

# Runtime
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=7864

# Logging
LOG_LEVEL=INFO
